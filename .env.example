# Copy to .env and enter your own credentials. Never commit .env.
# Use Binance Spot Testnet credentials for the default Testnet mode.
API_KEY=
API_SECRET=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Live Spot requires BOTH USE_TESTNET=false and ALLOW_LIVE_TRADING=true.
# Review your credentials/account before enabling Live Spot.
USE_TESTNET=true
ALLOW_LIVE_TRADING=false
AUTO_SCAN=true
MOMENTUM_ALERTS=true
ALLOW_BNB_FEES=false

TOP_N=100
APPROVAL_TTL_SECONDS=300
CHECK_TTL_SECONDS=600
